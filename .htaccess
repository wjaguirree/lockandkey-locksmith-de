# >>> legacy redirects (hand-added, NOT generated; safe from gen/redirects.mjs)
# Old-site URLs that Google still lists and that returned 404. Targets verified against the built site.
<IfModule mod_alias.c>
  Redirect 301 /contact/ /request/
  RedirectMatch 301 ^/delaware/?$ /service-areas/
  RedirectMatch 301 ^/delaware/(bethany-beach|bethel|blades|bowers-beach|bridgeville|camden|cheswold|clarksville|clayton|dagsboro|delmar|dewey-beach|dover|ellendale|farmington|felton|fenwick-island|frankford|frederica|georgetown|greenwood|harbeson|harrington|hartly|henlopen-acres|houston|kenton|laurel|leipsic|lewes|lincoln|little-creek|long-neck|magnolia|marydel|milford|millsboro|millville|milton|oak-orchard|ocean-view|rehoboth-beach|seaford|selbyville|slaughter-beach|smyrna|south-bethany|viola|woodside|wyoming)/?$ /service-areas/$1-de/
