# Lock and Key Locksmith DE
DirectoryIndex index.html
ErrorDocument 404 /404.html

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  # HTML must never be cached hard: every deploy changes it.
  ExpiresByType text/html "access plus 0 seconds"
  # Assets are cache-busted with ?v=YYYYMMDD, so they can be held a long time.
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

# www and the bare domain both served 200: same pages, two addresses.
# Send www to the bare domain, which is what every canonical tag names.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [R=301,L]
</IfModule>

# Trailing slash on directory URLs, so /lock-rekey and /lock-rekey/ never split.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} !(/$|\.)
  RewriteRule ^(.*)$ /$1/ [R=301,L]
</IfModule>

# >>> redirects
# ---- 301s from the previous site. Generated by gen/redirects.mjs ----
# Every target below was checked against the built site: a redirect to a
# missing page is worse than no redirect at all.
<IfModule mod_alias.c>
